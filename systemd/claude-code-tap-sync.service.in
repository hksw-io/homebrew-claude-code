[Unit]
Description=Mirror Claude Code releases into the HKSW Homebrew tap
After=network-online.target
Wants=network-online.target
ConditionPathExists=__ENV_FILE__

[Service]
Type=oneshot
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__REPO_ROOT__
Environment=HOME=__RUN_HOME__
EnvironmentFile=__ENV_FILE__
Environment=PYTHON3=__PYTHON3__
ExecStartPre=/usr/bin/test -w __REPO_ROOT__/.git
ExecStart=__REPO_ROOT__/scripts/run_update.sh
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=__REPO_ROOT__
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
UMask=0077
